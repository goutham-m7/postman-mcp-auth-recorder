              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Localized missing header\", () => pm.expect(pm.response.json().events.slice(-1)[0].reason).to.eql(\"missing_authorization\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "name": "12 Fetch token-safe timeline",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
