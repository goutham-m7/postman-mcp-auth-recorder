              "pm.test(\"MCP denied after token issued\", () => pm.expect(pm.response.json().error).to.eql(\"invalid_token\"));",
              "[\"access_token\", \"code\", \"verifier\", \"state\", \"client_id\", \"challenge\"].forEach(k => pm.variables.unset(k));"
            ],
            "type": "text/javascript"
          }
